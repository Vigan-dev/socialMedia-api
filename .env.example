MONGODB_URI=mongodb://localhost:27017/socialmedia
NODE_ENV=development
CLIENT_ORIGINS=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000
# Set to the exact number of trusted reverse proxies in production. Keep 0 locally.
TRUST_PROXY_HOPS=0
JWT_SECRET=replace-with-a-long-random-secret
# Keep this stable when rotating JWT_SECRET or existing 2FA setups will break.
TOTP_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
# Required in production. Uncomment and replace with your SMTP provider values.
# MAIL_FROM=SocialMedia <no-reply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
